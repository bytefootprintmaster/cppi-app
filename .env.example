# ---- Server ----
NODE_ENV=production
PORT=8787
APP_URL=https://app.cppimi.com

# Random long string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string

# ---- Google Sign-In (OAuth 2.0 Web client) ----
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JS origins:  https://app.cppimi.com  and  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AWS (region must be us-east-2) ----
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cppi-portal-files

# ---- Bootstrap ----
# Comma separated emails that are always granted the admin role on login.
ADMIN_EMAILS=

# Optional bootstrap admin account for normal email/password sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Optional: prefix for DynamoDB table names
TABLE_PREFIX=cppi_
