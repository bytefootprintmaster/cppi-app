# ---- Server ----
NODE_ENV=production
PORT=8787
APP_URL=https://app.cppimi.com

# Random long string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string

# ---- Google Sign-In (OAuth 2.0 Web client) ----
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JS origins:  https://app.cppimi.com  and  http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AWS (region must be us-east-2) ----
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=cppi-portal-files

# ---- Bootstrap ----
# Comma separated emails that are always granted the admin role on login.
ADMIN_EMAILS=

# Optional bootstrap admin account for normal email/password sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Optional: prefix for DynamoDB table names
TABLE_PREFIX=cppi_

# ---- Multi-tenancy ---------------------------------------------------------
# Platform super admins. They own the default workspace and are the only accounts
# that may invite someone to become the admin of their own workspace.
SUPER_ADMIN_EMAILS=

# Name given to the workspace that owns the data from before multi-tenancy.
BOOTSTRAP_ORG_NAME=CPPI

# Product limits every new workspace starts with (per period, see below).
DEFAULT_ORG_LIMITS_DOCS=50
DEFAULT_ORG_LIMITS_IMAGES=200
DEFAULT_ORG_LIMITS_ASSISTANT_ASKS=50
# monthly | lifetime
DEFAULT_ORG_LIMITS_PERIOD=monthly

# ---- Assistant chat --------------------------------------------------------
# The Python agent's HTTP ingress. The portal proxies the Assistant page to it,
# so these stay server-side and are never exposed to the browser.
# In the agent's .env set HTTP_API_ENABLED=true and the same HTTP_API_TOKEN.
AGENT_API_URL=http://127.0.0.1:8790
AGENT_API_TOKEN=
